# Start from a small official Python image so the container stays lightweight.
FROM python:3.11-slim

# All following commands run from this folder inside the container.
WORKDIR /app

# Copy dependency list first so Docker can cache package installation.
COPY requirements.txt /app/requirements.txt
# Install only runtime packages needed by the API service.
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy application source code into the image.
COPY src /app/src
COPY api /app/api

# Let Python find imports from our `src/` package layout.
ENV PYTHONPATH=/app/src
# Default host and port used by the API server.
ENV HOST=0.0.0.0
ENV PORT=8000

# Document the port this container listens on.
EXPOSE 8000

# Start the FastAPI app with Uvicorn when the container launches.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
